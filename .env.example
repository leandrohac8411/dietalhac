SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
GROQ_API_KEY=
# Opcional. O padrão é openai/gpt-oss-20b.
GROQ_DIET_MODEL=

# Web Push: gere com `npx web-push generate-vapid-keys --json`.
# A chave VITE_* é pública; a privada deve existir apenas no servidor/Vercel.
VITE_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:contato@seudominio.com
# Protege /api/push-cron quando chamado pelo Supabase Cron.
CRON_SECRET=
